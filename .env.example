# MongoDB Connection URI (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/asklordkrishna

# Application Port
PORT=8080

# JWT Configuration
JWT_SECRET=ask-lord-krishna-secure-secret-key-make-it-very-long-and-complex-for-production
JWT_EXPIRATION=86400000

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent


# Allowed CORS Origins (comma-separated for multiple origins, e.g. http://localhost:3000,https://your-frontend.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:3000
